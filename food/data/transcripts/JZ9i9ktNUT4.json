    },
    {
      "start": 365.64,
      "duration": 4.56,
      "text": "12대만 달러 하나로 약"
    },
    {
      "start": 367.68,
      "duration": 3.86,
      "text": "5,000원으로 다른 가게 버블티는"
    },
    {
      "start": 370.2,
      "duration": 3.64,
      "text": "비싼"
    },
    {
      "start": 371.54,
      "duration": 4.86,
      "text": "[음악]"
    },
    {
      "start": 373.84,
      "duration": 4.56,
      "text": "편이었어요 주문한 버블티가 나오길"
    },
    {
      "start": 376.4,
      "duration": 4.28,
      "text": "기다리면서 수제 타피오 커이"
    },
    {
      "start": 378.4,
      "duration": 5.24,
      "text": "만들어지는 과정을 쭉 볼 수"
    },
    {
      "start": 380.68,
      "duration": 5.68,
      "text": "있어요 마지막 단계가 대박이었는데"
    },
    {
      "start": 383.64,
      "duration": 4.92,
      "text": "버블에 흑설탕을 듬뿍 올리시더니"
    },
    {
      "start": 386.36,
      "duration": 4.96,
      "text": "공룡머리"
    },
    {
      "start": 388.56,
      "duration": 5.16,
      "text": "불이 에 블루지한 흑당이라 적혀"
    },
    {
      "start": 391.32,
      "duration": 4.96,
      "text": "있어서 번역이 잘못된 건가 있는데"
    },
    {
      "start": 393.72,
      "duration": 5.16,
      "text": "진짜 불리었고 일단 불맛을 입은"
    },
    {
      "start": 396.28,
      "duration": 5.04,
      "text": "흑설탕이 밀크티에 섞이니까 달고나"
    },
    {
      "start": 398.88,
      "duration": 4.76,
      "text": "맛도 살짝 나는 듯 했고요 지나치게"
    },
    {
      "start": 401.32,
      "duration": 5.0,
      "text": "달지 않은 부드러운 밀크티 맛 굉장히"
    },
    {
      "start": 403.64,
      "duration": 5.16,
      "text": "좋았습니다 무엇보다 쫀득쫀득한 버리"
    },
    {
      "start": 406.32,
      "duration": 4.56,
      "text": "예술이었는데 제가 한국에서 버블티를"
    },
    {
      "start": 408.8,
      "duration": 4.04,
      "text": "딱 한번 먹어 보고 버블티는 제"
    },
    {
      "start": 410.88,
      "duration": 4.44,
      "text": "스타일이 아닌 줄 알았거든요 근데"
    },
    {
      "start": 412.84,
      "duration": 4.84,
      "text": "이거 먹고 완전 흑당 버블티 러버가"
    },
    {
      "start": 415.32,
      "duration": 4.92,
      "text": "돼 버렸습니다 전통 수제 타피오카"
    },
    {
      "start": 417.68,
      "duration": 7.4,
      "text": "펄의 달콤 쫀득한 맛이 궁금 하시다면"
    },
    {
      "start": 420.24,
      "duration": 4.84,
      "text": "시딩 행복당 흑당 버블티 강력하게"
    },
    {
      "start": 429.96,
      "duration": 5.12,
      "text": "추천드려요 대만에는 3대 야시장이"
    },
    {
      "start": 432.6,
      "duration": 5.0,
      "text": "있는데요 그중 현지인들이 추천하는"
    },
    {
      "start": 435.08,
      "duration": 4.68,
      "text": "닝샤 야시장에 왔습니다 규모는 작지만"
    },
    {
      "start": 437.6,
      "duration": 6.64,
      "text": "알짜배기 먹걸이가 줄지어진 닝샤"
    },
    {
      "start": 439.76,
      "duration": 4.48,
      "text": "야시장 고소한 굴전 먼저"
    },
    {
      "start": 448.52,
      "duration": 4.8,
      "text": "먹어보겠습니다 연속 미슐랭 가이드에"
    },
    {
      "start": 450.72,
      "duration": 4.92,
      "text": "선정된 굴전 맛집이고요 평일이고"
    },
    {
      "start": 453.32,
      "duration": 4.8,
      "text": "주말이고 줄이 엄청난 곳이지만 굴전"
    },
    {
      "start": 455.64,
      "duration": 5.32,
      "text": "냄새 맡으면서 기다리다 보면 금방"
    },
    {
      "start": 458.12,
      "duration": 2.84,
      "text": "주문할 자리가"
    },
    {
      "start": 461.28,
      "duration": 4.92,
      "text": "옵니다 10분 정도 웨이팅한 후"
    },
    {
      "start": 463.72,
      "duration": 2.48,
      "text": "가게로"
    },
    {
      "start": 466.68,
      "duration": 5.96,
      "text": "들어왔어요 주문한 음식도 초스피드로"
    },
    {
      "start": 469.4,
      "duration": 5.4,
      "text": "나와요 이게 바로 굴전 촉촉보다는 끈"
    },
    {
      "start": 472.64,
      "duration": 5.88,
      "text": "적에 가까운 소스가 듬뿍 뿌려진"
    },
    {
      "start": 474.8,
      "duration": 5.24,
      "text": "굴전에 조금 당황했다가 먹어보고 바로"
    },
    {
      "start": 478.52,
      "duration": 4.04,
      "text": "대박 했습니다"
    },
    {
      "start": 480.04,
      "duration": 5.16,
      "text": "쫀득한데 고소함이 살아숨쉬는 맛이"
    },
    {
      "start": 482.56,
      "duration": 5.64,
      "text": "일품이네요 달달한 소스와의 조합도"
    },
    {
      "start": 485.2,
      "duration": 5.56,
      "text": "굉장히 좋았고요 매운가 좋아하시면이"
    },
    {
      "start": 488.2,
      "duration": 4.76,
      "text": "빨간 소스도 꼭 같이 드셔 보세요"
    },
    {
      "start": 490.76,
      "duration": 4.6,
      "text": "달달함 뒤에 오는 매콤함이 상당히"
    },
    {
      "start": 492.96,
      "duration": 5.0,
      "text": "매력적입니다 굴전과 함께 주문한"
    },
    {
      "start": 495.36,
      "duration": 5.08,
      "text": "조깃국은 굉장히 개운하고 감치 맛이"
    },
    {
      "start": 497.96,
      "duration": 5.8,
      "text": "좋았는데 생각 맛이 조금 강하더라고요"
    },
    {
      "start": 500.44,
      "duration": 5.8,
      "text": "굴전 먹다 가심 하기엔 딱 좋았어요"
    },
    {
      "start": 503.76,
      "duration": 5.16,
      "text": "저렴한 가격에 정말 만족스럽게 먹고"
    },
    {
      "start": 506.24,
      "duration": 5.04,
      "text": "또 먹으러가 볼게요 골점 먹고 나와서"
    },
    {
      "start": 508.92,
      "duration": 4.88,
      "text": "걷는데 줄이 어마어마하게 긴 곳이"
    },
    {
      "start": 511.28,
      "duration": 4.88,
      "text": "있는 거예요 대체 뭘 팔길래 저렇게"
    },
    {
      "start": 513.8,
      "duration": 5.04,
      "text": "긴 가해서 봤더니 오 통오징어튀김"
    },
    {
      "start": 516.16,
      "duration": 5.24,
      "text": "바로 줄서 봅니다 기다리면서 잔돈도"
    },
    {
      "start": 518.84,
      "duration": 4.88,
      "text": "탈탈 털어서 준비해 주고 싱싱한 통호"
    },
    {
      "start": 521.4,
      "duration": 4.16,
      "text": "징어의 감탄해 주고 그렇게 10분 또"
    },
    {
      "start": 523.72,
      "duration": 4.12,
      "text": "기다리니까 우리 차례가 왔어요"
    },
    {
      "start": 525.56,
      "duration": 4.88,
      "text": "통오징어 튀김 하나를 주문했습니다"
    },
    {
      "start": 527.84,
      "duration": 4.88,
      "text": "소스도 착착착 칼질도 착착 하시는"
    },
    {
      "start": 530.44,
      "duration": 4.72,
      "text": "모습 보고 있으니까 재밌더라고요"
    },
    {
      "start": 532.72,
      "duration": 5.0,
      "text": "마지막 칠리 소스까지 듬뿍 뿌려 주면"
    },
    {
      "start": 535.16,
      "duration": 4.72,
      "text": "완성입니다 가격이 150 대만 달러"
    },
    {
      "start": 537.72,
      "duration": 5.16,
      "text": "하나로 6,200원 정도로 가성비가"
    },
    {
      "start": 539.88,
      "duration": 5.68,
      "text": "대박이고 근데 맛은 더 대박이에요"
    },
    {
      "start": 542.88,
      "duration": 5.08,
      "text": "얇고 바삭한 튀김과 쫄깃한 오징어가"
    },
    {
      "start": 545.56,
      "duration": 4.76,
      "text": "정말 맛있었고요 무엇보다 그 속에"
    },
    {
      "start": 547.96,
      "duration": 4.52,
      "text": "채워진 오이와 무가 신의 한수 느끼할"
    },
    {
      "start": 550.32,
      "duration": 4.44,
      "text": "틈도 없이 아삭하게 치고 들어오는게"
    },
    {
      "start": 552.48,
      "duration": 4.2,
      "text": "식감이며 마시며 천재입니다 닝치"
    },
    {
      "start": 554.76,
      "duration": 4.52,
      "text": "야시장 가시면 이건 무조건 드셔"
    },
    {
      "start": 556.68,
      "duration": 6.8,
      "text": "보세요 먹걸리 천국 닝샤 야시장은"
    },
    {
      "start": 559.28,
      "duration": 4.2,
      "text": "여기까지 즐기고 다음 야시장으로가"
    },
    {
      "start": 566.16,
      "duration": 5.24,
      "text": "볼게요 이번에는 대만 3대 야시장 중"
    },
    {
      "start": 569.36,
      "duration": 4.36,
      "text": "걸리 놀거리 먹걸이가 가득한 라오"
    },
    {
      "start": 571.4,
      "duration": 4.56,
      "text": "어제 야시장에 왔습니다 여기는 타이베"
    },
    {
      "start": 573.72,
      "duration": 4.56,
      "text": "10일 전망대에서 차로 12분 거리라"
    },
    {
      "start": 575.96,
      "duration": 4.64,
      "text": "묶어서 건강하시면 딱 좋아요 처음에"
    },
    {
      "start": 578.28,
      "duration": 5.48,
      "text": "소개해 드린 잉시 야시장보다 규모가"
    },
    {
      "start": 580.6,
      "duration": 5.48,
      "text": "훨씬 큰 야시장이 입구부터 길게 쭉"
    },
    {
      "start": 583.76,
      "duration": 5.16,
      "text": "이어지는 로컬 느낌의 먹거리와 즐길"
    },
    {
      "start": 586.08,
      "duration": 5.52,
      "text": "거리에 구경하는 재미가 쏠쏠했습니다"
    },
    {
      "start": 588.92,
      "duration": 7.4,
      "text": "그런데 단 한 가지 조금 힘들었던"
    },
    {
      "start": 591.6,
      "duration": 4.72,
      "text": "부분은 중간중간 강력한 치두 부양"
    },
    {
      "start": 598.32,
      "duration": 4.72,
      "text": "구간이었지만 을 참아가면서 한 바퀴"
    },
    {
      "start": 600.8,
      "duration": 4.76,
      "text": "쭉 둘러본 뒤 대만식 버거를"
    },
    {
      "start": 603.04,
      "duration": 4.88,
      "text": "먹었습니다 바삭한 패스추리 안에"
    },
    {
      "start": 605.56,
      "duration": 4.76,
      "text": "고기랑 야채가 들어가 있는데 이건용"
    },
    {
      "start": 607.92,
      "duration": 4.68,
      "text": "제 스타일은 아니네요 중간에 상큼한"
    },
    {
      "start": 610.32,
      "duration": 5.12,
      "text": "오렌지 주스로 이겨내 보려고 했지만"
    },
    {
      "start": 612.6,
      "duration": 5.2,
      "text": "이것도 실패 줄이 길더라도 입구에는"
    },
    {
      "start": 615.44,
      "duration": 4.8,
      "text": "후추 빵이나 대만식 소세지를 드셔"
    },
    {
      "start": 617.8,
      "duration": 4.48,
      "text": "보시길 추천드리고요 달달함의 끝판왕인"
    },
    {
      "start": 620.24,
      "duration": 4.64,
      "text": "대만과의 석가도 한번 드셔 보세요"
    },
    {
      "start": 622.28,
      "duration": 5.2,
      "text": "정말 달고 맛있습니다 대만 야시장"
    },
    {
      "start": 624.88,
      "duration": 6.44,
      "text": "투어는 여기까지고요 바로이어서 대만"
    },
    {
      "start": 627.48,
      "duration": 3.84,
      "text": "아침 먹투어가 보실게요"
    },
    {
      "start": 634.64,
      "duration": 4.4,
      "text": "대만 여행에서 꼭 즐겨봐야 한다는"
    },
    {
      "start": 636.6,
      "duration": 4.08,
      "text": "아침 식사를 하러 왔어요 예스폭진지"
    },
    {
      "start": 639.04,
      "duration": 3.92,
      "text": "투어를 하는 날이라 9시 전에"
    },
    {
      "start": 640.68,
      "duration": 4.56,
      "text": "방문했는데도 일찍부터 온 사람들로"
    },
    {
      "start": 642.96,
      "duration": 4.4,
      "text": "가게가 북적북적 하더라고요 그래도"
    },
    {
      "start": 645.24,
      "duration": 5.12,
      "text": "회전율이 굉장히 빠른 편이니까 걱정"
    },
    {
      "start": 647.36,
      "duration": 5.0,
      "text": "마세요이 길쭉한 빵 이름이 요우티아오"
    },
    {
      "start": 650.36,
      "duration": 4.56,
      "text": "있데 대만 아침 메뉴에 빠질 수 없는"
    },
    {
      "start": 652.36,
      "duration": 4.8,
      "text": "아이라이 담아 봅니다 봉지에 담으라고"
    },
    {
      "start": 654.92,
      "duration": 3.8,
      "text": "사진으로 친절하게 안내되어 있고요"
    },
    {
      "start": 657.16,
      "duration": 3.96,
      "text": "그리고 미리 포장되어 있는 다른"
    },
    {
      "start": 658.72,
      "duration": 4.96,
      "text": "메뉴들 도 빠르게 스캔해서 골라볼게요"
    },
    {
      "start": 661.12,
      "duration": 5.4,
      "text": "여기 메뉴판에 한글이 다 적혀 있어서"
    },
    {
      "start": 663.68,
      "duration": 6.0,
      "text": "좋습니다 두유와 비슷한 또우 장까지"
    },
    {
      "start": 666.52,
      "duration": 5.56,
      "text": "쟁반에 담아서 계산하면 끝 여기서"
    },
    {
      "start": 669.68,
      "duration": 5.08,
      "text": "먹고 갈 거라 수저랑 소스를 좀"
    },
    {
      "start": 672.08,
      "duration": 5.28,
      "text": "챙겨서 자리를 잡아야겠어요 와중에"
    },
    {
      "start": 674.76,
      "duration": 5.4,
      "text": "2층 안내글에 기분이 좋아지는데요"
    },
    {
      "start": 677.36,
      "duration": 5.76,
      "text": "성공의 첫걸음을 내딛는 중입니다"
    },
    {
      "start": 680.16,
      "duration": 5.24,
      "text": "2층에 자리를 잡고 본격적으로 조식을"
    },
    {
      "start": 683.12,
      "duration": 4.68,
      "text": "즐겨 볼게요 완전 로컬 느낌의"
    },
    {
      "start": 685.4,
      "duration": 5.0,
      "text": "가게인데 포장이 너무 귀엽죠 또"
    },
    {
      "start": 687.8,
      "duration": 5.2,
      "text": "호장은 콩비린내 없는 맑은 느낌의"
    },
    {
      "start": 690.4,
      "duration": 4.88,
      "text": "콩국이 있어요 그다음은 요우티아오"
    },
    {
      "start": 693.0,
      "duration": 4.6,
      "text": "간이 전혀 되지 않은 밀가루 튀김맛"
    },
    {
      "start": 695.28,
      "duration": 3.68,
      "text": "솔직히 얘만 먹었을 땐 이게 왜 대만"
    },
    {
      "start": 697.6,
      "duration": 3.6,
      "text": "조식에 빠질 수 없는 메뉴지"
    },
    {
      "start": 698.96,
      "duration": 4.44,
      "text": "싶었거든요 근데이 또우장이랑 같이"
    },
    {
      "start": 701.2,
      "duration": 5.12,
