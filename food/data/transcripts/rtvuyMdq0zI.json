      "text": "[음악]"
    },
    {
      "start": 1160.2,
      "duration": 5.88,
      "text": "빙수입니다. 타이티"
    },
    {
      "start": 1162.84,
      "duration": 5.48,
      "text": "시켰습니다. 이렇게 버블티 같은 거를"
