    {
      "start": 737.6,
      "duration": 1.52,
      "text": ">> 맞아요."
    },
    {
      "start": 738.08,
      "duration": 4.92,
      "text": ">> 이게 도끼가 있어서"
    },
    {
      "start": 739.12,
      "duration": 6.48,
      "text": ">> 맞아 맞아 잘겨워야 돼요.이 이 딱이"
    },
    {
      "start": 743.0,
      "duration": 3.72,
      "text": "에어박의 두께가"
    },
    {
      "start": 745.6,
      "duration": 4.68,
      "text": ">> 영했다.이"
    },
    {
      "start": 746.72,
      "duration": 5.08,
      "text": ">> 명란의 짠맛을 완벽하게 중화시키면서"
    },
    {
      "start": 750.28,
      "duration": 5.56,
      "text": ">> 맞아요."
    },
    {
      "start": 751.8,
      "duration": 4.48,
      "text": ">> 겉는 단하지만 안에는 알편하게"
    },
    {
      "start": 755.84,
      "duration": 1.12,
      "text": "시켜요."
    },
    {
      "start": 756.28,
      "duration": 2.44,
      "text": ">> 맞아."
    },
    {
      "start": 756.96,
      "duration": 4.4,
      "text": ">> 진짜 처음 먹어보는"
    },
    {
      "start": 758.72,
      "duration": 5.8,
      "text": ">> 어 맞아 맞아. 처음 먹어보는 식감."
    },
    {
      "start": 761.36,
      "duration": 3.16,
      "text": "아, 맛있다."
    },
    {
      "start": 769.8,
      "duration": 3.32,
      "text": ">> 아, 행복하다."
    },
    {
      "start": 771.2,
      "duration": 6.52,
      "text": ">> 아, 진짜"
    },
    {
      "start": 773.12,
      "duration": 4.6,
      "text": ">> 야, 대만에 오면 너무 행복해."
    },
    {
      "start": 782.73,
      "duration": 2.02,
      "text": ">> [웃음]"
    },
    {
      "start": 786.88,
      "duration": 3.64,
      "text": ">> 아 맛있다."
    },
    {
      "start": 792.12,
      "duration": 5.72,
      "text": ">> 와 배불러"
    },
    {
      "start": 793.44,
      "duration": 6.08,
      "text": ">> 진짜 완벽한 식사였다. 진짜"
    },
    {
      "start": 797.84,
      "duration": 2.64,
      "text": ">> 아 대표님 제가 살게요."
    },
    {
      "start": 799.52,
      "duration": 1.96,
      "text": ">> 아이"
    },
    {
      "start": 800.48,
      "duration": 1.8,
      "text": ">> 아이"
    },
    {
      "start": 801.48,
      "duration": 3.0,
      "text": ">> 에이요."
    },
    {
      "start": 802.28,
      "duration": 4.92,
      "text": ">> 에이 나 이런 못 봐."
    },
    {
      "start": 804.48,
      "duration": 5.76,
      "text": ">> 뭐야? 액션을 왜 까는 거야?"
    },
    {
      "start": 807.2,
      "duration": 4.6,
      "text": "그게 아니라 생각보다"
    },
    {
      "start": 810.24,
      "duration": 2.08,
      "text": "돈이 안 나오네."
    },
    {
      "start": 811.8,
      "duration": 3.74,
      "text": ">> 뭐야?"
    },
    {
      "start": 812.32,
      "duration": 3.22,
      "text": ">> 잘다. [웃음]"
    },
    {
      "start": 816.68,
      "duration": 2.6,
      "text": ">> 와, 너무 맛있다. 근데"
    },
    {
      "start": 818.24,
      "duration": 1.84,
      "text": ">> 진짜 여기 좋다."
    },
    {
      "start": 819.28,
      "duration": 2.24,
      "text": ">> 예."
    },
    {
      "start": 820.08,
      "duration": 2.56,
      "text": ">> 야, 잘 찾았어. 태린아."
    },
    {
      "start": 821.52,
      "duration": 3.32,
      "text": ">> 진짜"
    },
    {
      "start": 822.64,
      "duration": 6.04,
      "text": ">> 진짜 대단한 사람이야. 잘 찾았다."
    },
    {
      "start": 824.84,
      "duration": 3.84,
      "text": ">> 잘 찾았다. 안 좋겠다."
    },
    {
      "start": 832.48,
      "duration": 3.24,
      "text": ">> 이게"
    },
    {
      "start": 834.28,
      "duration": 2.04,
      "text": "옛날 맥주간 거잖아요."
    },
    {
      "start": 835.72,
      "duration": 3.6,
      "text": ">> 진짜요?"
    },
    {
      "start": 836.32,
      "duration": 3.0,
      "text": ">> 예."
    },
    {
      "start": 849.16,
      "duration": 4.04,
      "text": "와"
    },
    {
      "start": 850.2,
      "duration": 3.0,
      "text": ">> 프지도이가"
    },
    {
      "start": 857.76,
      "duration": 5.64,
      "text": "포토존입니다. 여기서 꼭 사진을"
    },
    {
      "start": 859.88,
      "duration": 3.52,
      "text": "찍으셔야 돼요."
    },
    {
      "start": 864.48,
      "duration": 5.24,
      "text": "아 나 진짜 살찐 거 같아. 여러분"
    },
    {
      "start": 866.72,
      "duration": 3.0,
      "text": "어떡해요? Oh."
