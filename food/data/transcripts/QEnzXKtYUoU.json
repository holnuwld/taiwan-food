    {
      "start": 268.28,
      "duration": 4.48,
      "text": "메인역 같은 번화가는 나은 편인데"
    },
    {
      "start": 270.48,
      "duration": 4.48,
      "text": "중심지를 조금 벗어나거나 외곽 지역인"
    },
    {
      "start": 272.76,
      "duration": 4.0,
      "text": "지우펀 같은 곳에 있는 공중 화장실은"
    },
    {
      "start": 274.96,
      "duration": 4.04,
      "text": "차마 이용하기 힘들 정도로 더러운"
    },
    {
      "start": 276.76,
      "duration": 4.2,
      "text": "경우가 많아요 그래서 타입 a에서는"
    },
    {
      "start": 279.0,
      "duration": 4.32,
      "text": "웬만하면 휴진 항상 가지고 다니는게"
    },
    {
      "start": 280.96,
      "duration": 4.12,
      "text": "좋고 주변에 스타벅스나 절이 있다면"
    },
    {
      "start": 283.32,
      "duration": 4.56,
      "text": "그곳에 있는 화장실을 이용하는게 좋을"
    },
    {
      "start": 285.08,
      "duration": 4.64,
      "text": "거예요 또 폰에서는 공중 화장실보다는"
    },
    {
      "start": 287.88,
      "duration": 3.76,
      "text": "천등 가게 화장실을 쓰고 지유"
    },
    {
      "start": 289.72,
      "duration": 3.68,
      "text": "폰에서는 웬만하면 차집 들어가서 쓰는"
    },
    {
      "start": 291.64,
      "duration": 3.84,
      "text": "걸 추천할게요 그리고 아까 얘기한"
    },
    {
      "start": 293.4,
      "duration": 4.12,
      "text": "것처럼 이런 이유 때문에 주로 많이"
    },
    {
      "start": 295.48,
      "duration": 4.2,
      "text": "이동하는 동선이 시먼딩 쪽에 깔끔한"
    },
    {
      "start": 297.52,
      "duration": 5.08,
      "text": "속도로 잡아놓으면 한결 마음이 편안"
    },
    {
      "start": 299.68,
      "duration": 4.76,
      "text": "질 거예요 타이페이는 특별히 택시를"
    },
    {
      "start": 302.6,
      "duration": 4.0,
      "text": "이용하지 않아도 이동하는데 전혀"
    },
    {
      "start": 304.44,
      "duration": 4.24,
      "text": "문제가 없을 정도로 버스나 지하철이"
    },
    {
      "start": 306.6,
      "duration": 4.6,
      "text": "어디나 잘되어 있고 요금도 비싸지"
    },
    {
      "start": 308.68,
      "duration": 4.64,
      "text": "않은 편이에요 또 구글에서 목적지까지"
    },
    {
      "start": 311.2,
      "duration": 4.36,
      "text": "경로를 검색하면 대중교통을 이용해"
    },
    {
      "start": 313.32,
      "duration": 4.36,
      "text": "가는 가장 빠른 경로와 도착 시간까지"
    },
    {
      "start": 315.56,
      "duration": 4.12,
      "text": "정확하게 나오는 편이어서 더욱 어딜"
    },
    {
      "start": 317.68,
      "duration": 3.76,
      "text": "가든 대중 교통을 이용해서 여행하는게"
    },
    {
      "start": 319.68,
      "duration": 4.2,
      "text": "어렵지가 않아요 그래서 다른 건"
    },
    {
      "start": 321.44,
      "duration": 4.56,
      "text": "몰라도 우리나라 팀머니 교통 카드처럼"
    },
    {
      "start": 323.88,
      "duration": 4.2,
      "text": "지하철이나 버스 기차 등 웬만한"
    },
    {
      "start": 326.0,
      "duration": 4.44,
      "text": "대중교통은 다 이용할 수 있는이지"
    },
    {
      "start": 328.08,
      "duration": 4.68,
      "text": "카드는 여행하는 동안 필스 이에요이지"
    },
    {
      "start": 330.44,
      "duration": 4.4,
      "text": "카드는 공항이나 MRT 역들도 살 수"
    },
    {
      "start": 332.76,
      "duration": 4.08,
      "text": "있는데 저희가 산 것처럼 이런 다양한"
    },
    {
      "start": 334.84,
      "duration": 4.36,
      "text": "디자인으로 사고 싶으면 시먼딩 쪽"
    },
    {
      "start": 336.84,
      "duration": 4.4,
      "text": "편의점에서 구매하면 되고 저희는 짱구"
    },
    {
      "start": 339.2,
      "duration": 4.76,
      "text": "카드 120 대만 달러이 캐릭터"
    },
    {
      "start": 341.24,
      "duration": 4.8,
      "text": "카드는 189 대만 달러에 구입했어요"
    },
    {
      "start": 343.96,
      "duration": 4.36,
      "text": "또 얼마나 충전하는게 좋을지 궁금한"
    },
    {
      "start": 346.04,
      "duration": 4.32,
      "text": "사람이 있을 텐데 우선 박단"
    },
    {
      "start": 348.32,
      "duration": 4.16,
      "text": "100대만 달러 정도만 충전하고"
    },
    {
      "start": 350.36,
      "duration": 4.12,
      "text": "필요할 때마다 더 충전하는게 좋아요"
    },
    {
      "start": 352.48,
      "duration": 4.12,
      "text": "여행 동안 쓰고 마지막에 남은 두는"
    },
    {
      "start": 354.48,
      "duration": 4.44,
      "text": "스스로 20대만 달러와 카드 금액을"
    },
    {
      "start": 356.6,
      "duration": 4.12,
      "text": "제외하고 환불이 된다는데 요요 기간이"
    },
    {
      "start": 358.92,
      "duration": 3.72,
      "text": "20년이라 서 굳이 환불 안 하고"
    },
    {
      "start": 360.72,
      "duration": 3.96,
      "text": "기념품 사마 간직하는 사람이 더 많은"
    },
    {
      "start": 362.64,
      "duration": 4.4,
      "text": "거 같아요 저희도 한국 돌아오는"
    },
    {
      "start": 364.68,
      "duration": 4.36,
      "text": "비행기 타려고 공항 도착하니까 75"
    },
    {
      "start": 367.04,
      "duration": 3.96,
      "text": "대만 달러가 남았는데 탑승게이트"
    },
    {
      "start": 369.04,
      "duration": 3.8,
      "text": "들어와서 이렇게 생긴 자판기에서"
    },
    {
      "start": 371.0,
      "duration": 4.12,
      "text": "과자랑 음료수 사서 비행기에서 너무"
    },
    {
      "start": 372.84,
      "duration": 4.52,
      "text": "요긴하게 잘 먹었어서 큰 금액 남은"
    },
    {
      "start": 375.12,
      "duration": 4.48,
      "text": "경우가 아니라면이 방법 완전 추천하고"
    },
    {
      "start": 377.36,
      "duration": 4.52,
      "text": "싶어요 그리고 하나 더 대만의"
    },
    {
      "start": 379.6,
      "duration": 4.36,
      "text": "지하철이 MRT 탈 때 꼭 알아둬야"
    },
    {
      "start": 381.88,
      "duration": 4.4,
      "text": "하는게 음식물이나 음료 심지어"
    },
    {
      "start": 383.96,
      "duration": 4.56,
      "text": "물까지도 엄격하게 금지되어 있어서"
    },
    {
      "start": 386.28,
      "duration": 4.88,
      "text": "걸리면 자비없이 벌금이 30만 원"
    },
    {
      "start": 388.52,
      "duration": 4.68,
      "text": "정도 부과된다고 하니 절대 MRT는"
    },
    {
      "start": 391.16,
      "duration": 3.88,
      "text": "뭘 먹지 않는게 좋을 것 같아요"
    },
    {
      "start": 393.2,
      "duration": 3.88,
      "text": "교통에 대해서 얘기한 김에 우리나라"
    },
    {
      "start": 395.04,
      "duration": 3.76,
      "text": "항공편이 많이 도착하는 타오 위한"
    },
    {
      "start": 397.08,
      "duration": 3.84,
      "text": "공항에서 시내까지 가는 방법에"
    },
    {
      "start": 398.8,
      "duration": 4.32,
      "text": "대해서도 알려 드릴게요 공항에선"
    },
    {
      "start": 400.92,
      "duration": 4.16,
      "text": "MRT 국광 버스라고 하는 버스"
    },
    {
      "start": 403.12,
      "duration": 4.0,
      "text": "택시를 이용해서 시내로 갈 수 있는데"
    },
    {
      "start": 405.08,
      "duration": 4.44,
      "text": "밤 도착 비행기가 아니라면 빠르고"
    },
    {
      "start": 407.12,
      "duration": 4.72,
      "text": "쾌적한 MRT 가장 많이 이용해요"
    },
    {
      "start": 409.52,
      "duration": 4.48,
      "text": "MRT 우리나라 공항에서 공항 철도"
    },
    {
      "start": 411.84,
      "duration": 4.64,
      "text": "타는 거랑 진짜 거의 똑같아서이지"
    },
    {
      "start": 414.0,
      "duration": 4.8,
      "text": "카드를 산다면 충전에서 타면 되고이지"
    },
    {
      "start": 416.48,
      "duration": 4.64,
      "text": "카드 없이 탑승권을 구매하려면 공항에"
    },
    {
      "start": 418.8,
      "duration": 4.36,
      "text": "있는 기계에서 160대만 달러로 주고"
    },
    {
      "start": 421.12,
      "duration": 3.8,
      "text": "구입하면 되는데 한국어도 지원에"
    },
    {
      "start": 423.16,
      "duration": 4.4,
      "text": "잘하니까 전혀 어렵지 않게 살 수"
    },
    {
      "start": 424.92,
      "duration": 4.56,
      "text": "있을 거예요 MRT 타면 급행 열차로"
    },
    {
      "start": 427.56,
      "duration": 4.6,
      "text": "타이베이 매인 역까지 35분 정도"
    },
    {
      "start": 429.48,
      "duration": 4.84,
      "text": "소요되는데 급행열차는 9시 반쯤 일반"
    },
    {
      "start": 432.16,
      "duration": 4.4,
      "text": "열차는 11시 반쯤이 막 차니까 그"
    },
    {
      "start": 434.32,
      "duration": 4.6,
      "text": "이후에 도착한다면 국광 버스나 택시를"
    },
    {
      "start": 436.56,
      "duration": 4.64,
      "text": "이용해야 돼요 국광 버스는 막차가"
    },
    {
      "start": 438.92,
      "duration": 4.68,
      "text": "새벽 2시 10분 정도까지 있고 공항"
    },
    {
      "start": 441.2,
      "duration": 4.72,
      "text": "도착해서 아래층으로 한층 내려가서"
    },
    {
      "start": 443.6,
      "duration": 4.28,
      "text": "이렇게 생긴 매표소에서 132 대만"
    },
    {
      "start": 445.92,
      "duration": 3.56,
      "text": "달러의 표를 구매할 수 있어요 표를"
    },
    {
      "start": 447.88,
      "duration": 4.04,
      "text": "사고 나서 밖에 있는 5번 정류장"
    },
    {
      "start": 449.48,
      "duration": 4.52,
      "text": "장에서 타고 45분 정도 가면 되는데"
    },
    {
      "start": 451.92,
      "duration": 3.84,
      "text": "버스도 쾌적하게 잘 되어 있어서 반"
    },
    {
      "start": 454.0,
      "duration": 3.76,
      "text": "비행기라 MRT 못 탔다고 전혀"
    },
    {
      "start": 455.76,
      "duration": 4.36,
      "text": "억울해 할 필요는 없을 것 같아요"
    },
    {
      "start": 457.76,
      "duration": 4.52,
      "text": "아무튼 MRT 버스든 타이 A 메인"
    },
    {
      "start": 460.12,
      "duration": 4.04,
      "text": "역으로 먼저 도착하는데 만약 시원"
    },
    {
      "start": 462.28,
      "duration": 4.32,
      "text": "딩의 숙소를 잡았다면 메인역에서"
    },
    {
      "start": 464.16,
      "duration": 4.76,
      "text": "버스나 MRT 그린라인 택시를 타고"
    },
    {
      "start": 466.6,
      "duration": 4.2,
      "text": "심한 역으로 이동하면 돼요 걸어서도"
    },
    {
      "start": 468.92,
      "duration": 4.16,
      "text": "10분 15분이면 갈 수 있으니까"
    },
    {
      "start": 470.8,
      "duration": 4.56,
      "text": "걸어가도 괜찮은데 밤이 되면 타이페이"
    },
    {
      "start": 473.08,
      "duration": 4.36,
      "text": "메인역 여기저기에 노숙자들이 엄청나게"
    },
    {
      "start": 475.36,
      "duration": 4.28,
      "text": "많아지기 때문에 조금 불안하다면"
    },
    {
      "start": 477.44,
      "duration": 4.2,
      "text": "첫날은 메인역 쪽에 숙소를 잡거나"
    },
    {
      "start": 479.64,
      "duration": 4.6,
      "text": "도착해서 택시를 타는 것도 좋은"
    },
    {
      "start": 481.64,
      "duration": 4.8,
      "text": "방법이에요 군교 투어는 버스 투어나"
    },
    {
      "start": 484.24,
      "duration": 3.96,
      "text": "택시 투어를 이용할 수도 있고 셀프로"
    },
    {
      "start": 486.44,
      "duration": 3.6,
      "text": "버스나 열차를 이용해서 갈 수도"
    },
    {
      "start": 488.2,
      "duration": 4.0,
      "text": "있어요 타이페이에 대해 조금"
    },
    {
      "start": 490.04,
      "duration": 4.88,
      "text": "찾아봤다는 아마 대부분 알겠지만"
    },
    {
      "start": 492.2,
      "duration": 5.56,
      "text": "투어코스는 대부분 예류지질 공원 스펀"
    },
    {
      "start": 494.92,
      "duration": 5.28,
      "text": "스폰 폭포 진과스 지우펀이 다섯 가지"
    },
    {
      "start": 497.76,
      "duration": 5.36,
      "text": "관광지의 앞글자를 따서 예스폭진지"
    },
    {
      "start": 500.2,
      "duration": 4.92,
      "text": "예스진지 예스지 이런 식으로 구성되어"
    },
    {
      "start": 503.12,
      "duration": 4.44,
      "text": "있어요 버스 투어는 가격이 만 원"
    },
    {
      "start": 505.12,
      "duration": 4.52,
      "text": "정도로 저렴한데 이동도 편하고 한국인"
    },
    {
      "start": 507.56,
      "duration": 4.12,
      "text": "가이드가 설명을 잘 해 주기도 해서"
    },
    {
      "start": 509.64,
      "duration": 4.16,
      "text": "부담없이 편하게 근교를 둘러보고 싶은"
    },
    {
      "start": 511.68,
      "duration": 4.2,
      "text": "사람은 버스 투어를 이용하면 되고"
    },
    {
      "start": 513.8,
      "duration": 4.04,
      "text": "조금 더 비용을 주더라도 프라이빗하게"
    },
    {
      "start": 515.88,
      "duration": 3.76,
      "text": "내가 원하는 여행지만 빠르게 다니고"
    },
    {
      "start": 517.84,
      "duration": 3.8,
      "text": "싶은 사람은 15만 원 정도 하는"
    },
    {
      "start": 519.64,
      "duration": 3.76,
      "text": "택시 투어를 이용하면 되는데 일행이"
    },
    {
      "start": 521.64,
      "duration": 3.6,
      "text": "네명 이상이라면 이것도 나쁘지 않은"
    },
    {
      "start": 523.4,
      "duration": 3.88,
      "text": "선택인 거 같아요 팁을 한 가지"
    },
    {
      "start": 525.24,
      "duration": 4.16,
      "text": "주자면 버스 투어는 미리 예약을 안"
    },
    {
      "start": 527.28,
      "duration": 4.0,
      "text": "하면 내가 원하는 일정에 모든 투어가"
    },
    {
      "start": 529.4,
      "duration": 3.76,
      "text": "마감되는 경우가 있으니까 네이버"
    },
    {
      "start": 531.28,
      "duration": 3.88,
      "text": "스토어나 마이리얼 트립 같은 곳에서"
    },
    {
      "start": 533.16,
      "duration": 4.2,
      "text": "미리 예약을 해 두는게 좋고 반면"
    },
    {
      "start": 535.16,
      "duration": 4.92,
      "text": "택시 투어는 전날 예약해도 얼마든지"
    },
    {
      "start": 537.36,
      "duration": 5.04,
      "text": "떠날 수 있어요 우르르 몰려다니면서"
    },
    {
      "start": 540.08,
      "duration": 4.4,
      "text": "정해진 시간 동안 관광지만 돌아다니는"
    },
    {
      "start": 542.4,
      "duration": 4.12,
      "text": "것도 싫다거나 돈 많이 안 들이고"
    },
    {
      "start": 544.48,
      "duration": 3.96,
      "text": "현지인들이 이용하는 교통 수단으로"
    },
    {
      "start": 546.52,
      "duration": 4.32,
      "text": "자유롭게 다녀오고 싶은 사람이라면"
    },
    {
      "start": 548.44,
      "duration": 4.44,
      "text": "버스나 택시 투어 말고도 셀프 투어로"
    },
    {
      "start": 550.84,
      "duration": 4.08,
      "text": "다녀오는 것도 괜찮다고 생각해요"
    },
    {
      "start": 552.88,
      "duration": 4.2,
      "text": "저희도 이번 여행에서 가보고 싶었던"
    },
    {
      "start": 554.92,
      "duration": 4.28,
      "text": "스파하고 지우 판만 대중 교통을"
    },
    {
      "start": 557.08,
      "duration": 4.0,
      "text": "이용해서 다녀왔는데 이동 시간이 많이"
    },
    {
      "start": 559.2,
      "duration": 4.4,
      "text": "걸리는 편이긴 했지만 이동하면서"
    },
    {
      "start": 561.08,
      "duration": 4.52,
      "text": "중간중간 낯선 동네에 들려서 구경도"
    },
    {
      "start": 563.6,
      "duration": 4.64,
      "text": "하고 자유롭게 다닐 수 있어서 나름"
    },
    {
      "start": 565.6,
      "duration": 4.36,
      "text": "재밌었어요 혹시라도 저희처럼 셀프로"
    },
    {
      "start": 568.24,
      "duration": 3.56,
      "text": "스폰하고 지우 판만 다녀오고 싶은"
    },
    {
      "start": 569.96,
      "duration": 4.48,
      "text": "사람을 위해 자세한 방법은 아래에"
    },
    {
      "start": 571.8,
      "duration": 4.52,
      "text": "더보기에 자세히 올려 놓을게요 타이베"
    },
    {
      "start": 574.44,
      "duration": 3.52,
      "text": "기념품 중 가장 많이 대사는 건"
    },
    {
      "start": 576.32,
      "duration": 3.36,
      "text": "머니머니해도 누가크래커 orang"
    },
    {
      "start": 577.96,
      "duration": 3.8,
      "text": "펑리 수인데 개인적으로 아주"
    },
    {
      "start": 579.68,
      "duration": 3.96,
      "text": "특별하다고 생각하지 않지만 막상"
    },
    {
      "start": 581.76,
      "duration": 4.24,
      "text": "가볍게 선물하기에는 또 이만한게"
    },
    {
      "start": 583.64,
      "duration": 4.2,
      "text": "없기도 해서 저희도 몇 개 구매했어요"
    },
    {
      "start": 586.0,
      "duration": 3.8,
      "text": "진짜 다양한 곳에서 누가 크래커를"
    },
    {
      "start": 587.84,
      "duration": 4.56,
      "text": "펑리 수를 먹어 봤는데 개인적으로"
    },
    {
      "start": 589.8,
      "duration": 4.68,
      "text": "펑리수는 여기가 제일 맛있었고 한국인"
    },
    {
      "start": 592.4,
      "duration": 3.68,
      "text": "직원들도 있어서 구매하기도 편한데"
    },
    {
      "start": 594.48,
      "duration": 3.52,
      "text": "가족도 다른 데에 비해 합리적인"
    },
    {
      "start": 596.08,
      "duration": 4.12,
      "text": "편이었어요 그리고 누가 크래커는"
    },
    {
      "start": 598.0,
      "duration": 4.16,
      "text": "저희가 간날은 하필 쉬는 날이어서"
    },
    {
      "start": 600.2,
      "duration": 3.88,
      "text": "한국 사람들한테 유독 유명한 미미"
    },
    {
      "start": 602.16,
      "duration": 3.72,
      "text": "크래커와 라뜰리에 루터스 man 빼고"
    },
    {
      "start": 604.08,
      "duration": 3.96,
      "text": "거의 다 먹어 본 거 같은데 세인트"
    },
    {
      "start": 605.88,
      "duration": 4.2,
      "text": "피터가 제일 싸 그려 같지 않고 맛이"
    },
    {
      "start": 608.04,
      "duration": 3.88,
      "text": "있어서 누가 크래커와 펑리수는이 두"
    },
    {
      "start": 610.08,
      "duration": 3.72,
      "text": "곳을 추천해 주고 싶어요 사실 누가"
    },
    {
      "start": 611.92,
      "duration": 3.84,
      "text": "크래커가 펑리수 다 더 추천해 주고"
    },
    {
      "start": 613.8,
      "duration": 3.76,
      "text": "싶은 것들이 몇 가지 있는데 일단"
    },
    {
      "start": 615.76,
      "duration": 4.64,
      "text": "대만은 양주 가격이 정말 저렴한"
    },
    {
      "start": 617.56,
      "duration": 5.12,
      "text": "편이에요 특히 대만산 위스킨 카발란"
    },
    {
      "start": 620.4,
      "duration": 4.0,
      "text": "유명한데 대표적으로이 파란색 카발란"
    },
    {
      "start": 622.68,
      "duration": 3.68,
      "text": "솔리스트 700mm 가격이"
    },
    {
      "start": 624.4,
      "duration": 4.04,
      "text": "우리나라에서는 30만 원 중후반"
    },
    {
      "start": 626.36,
      "duration": 4.6,
      "text": "대인데 대만 카르프 회장에서는"
    },
    {
      "start": 628.44,
      "duration": 4.6,
      "text": "3,220 대만 달러로 훨씬 저렴하게"
    },
    {
      "start": 630.96,
      "duration": 5.28,
      "text": "살 수 있어요 꼭 대만산 위스키가"
    },
    {
      "start": 633.04,
      "duration": 5.72,
      "text": "아니어도 다른 유명한 위스키나"
    },
    {
      "start": 636.24,
      "duration": 4.56,
      "text": "고량주도수 수 있어서 술 좋아하거나"
    },
    {
      "start": 638.76,
      "duration": 4.24,
      "text": "선물할 리 있는 사람들은 한두 병 쯤"
    },
    {
      "start": 640.8,
      "duration": 4.24,
      "text": "구매해 봐도 좋을 것 같아요 가르프"
    },
    {
      "start": 643.0,
      "duration": 4.32,
      "text": "매장은 심원 쪽에서 가까운 뿌이 한"
    },
    {
      "start": 645.04,
      "duration": 4.24,
      "text": "점과 메인역에서 가까운 충칭 점이"
    },
    {
      "start": 647.32,
      "duration": 4.72,
      "text": "있는데 자세한 위치는 더 보기에"
    },
    {
      "start": 649.28,
      "duration": 4.48,
      "text": "구글지도 유아를 남겨 놓을게요 까르프"
    },
    {
      "start": 652.04,
      "duration": 3.52,
      "text": "얘기가 나온 김에 저희가 구매하고"
    },
    {
      "start": 653.76,
      "duration": 4.84,
      "text": "만족했던 아이템도 몇 가지 추천해"
    },
    {
      "start": 655.56,
      "duration": 4.96,
      "text": "줄게요 먼저 히스 허스라 캐슈넛도"
    },
    {
      "start": 658.6,
      "duration": 3.56,
      "text": "구매해 봤는 데 이것도 너무"
    },
    {
      "start": 660.52,
      "duration": 4.32,
      "text": "맛있었어요 과하지 않게 적당히"
    },
    {
      "start": 662.16,
      "duration": 4.84,
      "text": "짭짤하면서 양념맛도 살짝 베어 있고"
    },
    {
      "start": 664.84,
      "duration": 4.72,
      "text": "고소에서 여태까지 먹어본 캐슈는 스낵"
    },
    {
      "start": 667.0,
      "duration": 4.44,
      "text": "중에서는 가장 맛있었던 거 같아요"
    },
    {
      "start": 669.56,
      "duration": 4.52,
      "text": "견과를 좋아하는 사람이라면 하나쯤"
    },
    {
      "start": 671.44,
      "duration": 4.32,
      "text": "꼭서 먹어 보세요 또이 컵라면도 대만"
    },
    {
      "start": 674.08,
      "duration": 3.8,
      "text": "현지인 추천으로 구매해 봤는데"
    },
    {
      "start": 675.76,
      "duration": 4.32,
      "text": "우리나라 컵 라면하고 다르게 소스"
    },
    {
      "start": 677.88,
      "duration": 4.16,
      "text": "향부터 대만의 향이 확 나기도 하고"
    },
    {
      "start": 680.08,
      "duration": 4.12,
      "text": "고기도 이렇게 크게 크게 들어 있는데"
    },
    {
      "start": 682.04,
      "duration": 4.4,
      "text": "뭔가 컵 라면보다는 밀키트를 해먹는"
    },
    {
      "start": 684.2,
      "duration": 4.4,
      "text": "느낌이었어요 대만 식당에서 먹었던"
    },
    {
      "start": 686.44,
      "duration": 4.68,
      "text": "우육면 다 면이 얇고 간도 그렇게"
    },
    {
      "start": 688.6,
      "duration": 4.44,
      "text": "세지가 않 저희 입맛에 오히려 더 잘"
    },
    {
      "start": 691.12,
      "duration": 4.76,
      "text": "맞았던 거 같아요 생각보다 너무"
    },
    {
      "start": 693.04,
      "duration": 4.88,
      "text": "맛있게 먹었어서 완전 추천해요 그리고"
    },
    {
      "start": 695.88,
      "duration": 4.12,
      "text": "많이들 알고 있는 세시 시은 밀크티"
    },
    {
      "start": 697.92,
      "duration": 4.4,
      "text": "오리지널 맛도 구매했는데 인사에서"
    },
    {
      "start": 700.0,
      "duration": 4.24,
      "text": "먹는 밀크티 맛이랑 정말 비슷하고"
    },
    {
      "start": 702.32,
      "duration": 4.16,
      "text": "따뜻하게 먹어도 차갑게 먹어도 다"
    },
    {
      "start": 704.24,
      "duration": 4.32,
      "text": "맛있어서 밀크티 좋아하는 사람한테는"
    },
    {
      "start": 706.48,
      "duration": 4.0,
      "text": "추천하고 싶어요 우리나라에서도 파는"
    },
    {
      "start": 708.56,
      "duration": 4.04,
      "text": "곳이 있지만 대만에 비해 세배 정도"
    },
    {
      "start": 710.48,
      "duration": 4.36,
      "text": "비싸기도 해서 하나쯤 사하는 것도"
    },
    {
      "start": 712.6,
      "duration": 4.32,
      "text": "좋을 것 같아요 그리고 마지막으로"
    },
    {
      "start": 714.84,
      "duration": 3.92,
      "text": "스타벅스에서 파는 자몽언니 시럽도"
    },
    {
      "start": 716.92,
      "duration": 3.76,
      "text": "추천해 주고 싶어요 개인적으로"
    },
    {
      "start": 718.76,
      "duration": 4.08,
      "text": "스타벅스 스 자몽언니 블랙 티를 정말"
    },
    {
      "start": 720.68,
      "duration": 4.68,
      "text": "좋아하는데 거기 사용되는 청을 대만"
    },
    {
      "start": 722.84,
      "duration": 4.6,
      "text": "스타벅스에서 한정 판매하고 있더라고요"
    },
    {
      "start": 725.36,
      "duration": 4.0,
      "text": "한국에서는 인터넷 직구로만 구매할 수"
    },
    {
      "start": 727.44,
      "duration": 4.08,
      "text": "있어서 대만 갔을 때 기념품으로"
    },
    {
      "start": 729.36,
      "duration": 4.0,
      "text": "사오기 좋은 것 같아요 저는 신원"
    },
    {
      "start": 731.52,
      "duration": 3.96,
      "text": "딩에 있는 스타벅스에서 구매했고"
    },
    {
      "start": 733.36,
      "duration": 4.88,
      "text": "가격은 한 병에 250 대만 달러 약"
    },
    {
      "start": 735.48,
      "duration": 4.56,
      "text": "만 원에 구매했어요 혹시라도 스타벅스"
    },
    {
      "start": 738.24,
      "duration": 3.68,
      "text": "자업 좋아하는 사람은 한 병 사서"
    },
    {
      "start": 740.04,
      "duration": 4.08,
      "text": "먹거나 선물하기 좋은 것 같아서"
    },
    {
      "start": 741.92,
      "duration": 4.04,
      "text": "추천할게요 타이페이 여행하면서 꼭"
    },
    {
      "start": 744.12,
      "duration": 4.08,
      "text": "말해 주고 싶었던 정보들 신나게"
    },
    {
      "start": 745.96,
      "duration": 4.32,
      "text": "얘기하다 보니 너무 길어져 버렸어요"
    },
    {
      "start": 748.2,
      "duration": 4.24,
      "text": "그래도 지금까지 은 사람이라면 적어도"
    },
    {
      "start": 750.28,
      "duration": 3.52,
      "text": "한두 개는 타이페이 여행 중에 분명"
    },
    {
      "start": 752.44,
      "duration": 3.8,
      "text": "도움되는 정보가 있을 거라고"
    },
    {
      "start": 753.8,
      "duration": 4.72,
      "text": "생각해요이 영상이 반응이 좋으면 아직"
    },
    {
      "start": 756.24,
      "duration": 4.4,
      "text": "못 다운 꿀팁 미한 영상도 만들어"
    },
    {
      "start": 758.52,
      "duration": 3.92,
      "text": "볼게요 긴 영상 끝까지 봐줘서"
    },
    {
      "start": 760.64,
      "duration": 3.8,
      "text": "감사하고요 도움이 되었다면 구독과"
    },
    {
      "start": 762.44,
      "duration": 6.64,
      "text": "좋아요도 부탁할게요 즐거운 여행"
    },
    {
      "start": 764.44,
      "duration": 4.64,
      "text": "드세요 시청해 주셔서 감사합니다"
    }
  ]
}