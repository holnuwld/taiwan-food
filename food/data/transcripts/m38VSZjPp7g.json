    {
      "start": 1123.99,
      "duration": 4.02,
      "text": "[음악]"
    },
    {
      "start": 1130.52,
      "duration": 2.76,
      "text": "다른 거 같은데"
    },
    {
      "start": 1133.4,
      "duration": 13.58,
      "text": "[음악]"
    },
    {
      "start": 1147.32,
