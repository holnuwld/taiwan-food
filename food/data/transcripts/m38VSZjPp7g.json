    {
      "start": 875.24,
      "duration": 3.72,
      "text": "해서는데"
    },
    {
      "start": 876.84,
      "duration": 3.4,
      "text": "그럴까요? 여기 지방분의 차가"
    },
    {
      "start": 878.96,
      "duration": 2.6,
      "text": "있다고. 그래서 그걸 많이"
    },
    {
      "start": 880.24,
      "duration": 4.32,
      "text": "마시더라고. 우리도 그걸 나눠서"
    },
    {
      "start": 881.56,
      "duration": 3.0,
      "text": "살까?"
    },
