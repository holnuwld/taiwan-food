      "start": 886.18,
      "duration": 3.11,
      "text": "[음악]"
    },
    {
      "start": 892.4,
      "duration": 3.09,
      "text": "[음악]"
    },
    {
      "start": 899.88,
      "duration": 5.48,
      "text": "쓴맛이다 완전 근데 이게 쓰긴 한데"
    },
    {
      "start": 903.24,
      "duration": 5.4,
      "text": "이게 뭐 지방 분해한다고 하니까 먹어"
    },
    {
      "start": 905.36,
      "duration": 3.28,
      "text": "보는 걸로"
    },
    {
      "start": 910.24,
      "duration": 3.56,
      "text": "거기 명동"
    },
    {
      "start": 912.24,
      "duration": 3.8,
      "text": "아닌"
    },
    {
      "start": 913.8,
      "duration": 4.04,
      "text": "1천이면 1천이면 4만 원이 4만"
    },
    {
      "start": 916.04,
      "duration": 6.16,
      "text": "원인지 비싸네"
    },
    {
      "start": 917.84,
      "duration": 4.36,
      "text": "그냥 집앞에 사는게 더 쌀"
